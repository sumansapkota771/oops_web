# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Supabase ─ Dashboard → Project Settings → API ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" or "publishable" key (safe for the browser; row level security protects the data).
# Either variable name works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "service_role" / secret key — SERVER ONLY. Needed for the admin panel to save changes and upload files.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, for `pnpm db:setup` to apply the SQL automatically (otherwise paste
# supabase/migrations/0001_init.sql into the Supabase SQL Editor once).
# Dashboard → Connect → "Direct connection" or Session pooler string.
SUPABASE_DB_URL=
# …or a personal access token from supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── Admin sign-in ─────────────────────────────────────────────────────────────
# Secret used to sign login cookies: any random string of 32+ characters. Keep it private.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Create the first admin with:  pnpm admin:create you@gmail.com
# After that, admins add more users (and make them admins) at /admin/users.

# ── Enquiry emails (Gmail via Nodemailer) — optional; enquiries are always saved in Supabase ──
# Everyone listed here receives each "Book now" / Contact message (comma-separated).
ENQUIRY_TO_EMAIL=info.oopsnepal@gmail.com,marketing.oops.np@gmail.com
# The Gmail account that sends the emails. Turn on 2-Step Verification, then create an app password:
# https://myaccount.google.com/apppasswords
SMTP_USER=marketing.oops.np@gmail.com
SMTP_PASS=
# Optional overrides: SMTP_HOST (smtp.gmail.com), SMTP_PORT (465), SMTP_FROM ("OOPS! Nepal Website <you@gmail.com>")
